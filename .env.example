# Gemini is the hosted demo mode. Keep your real key in an untracked .env file.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# For local mode, set LLM_PROVIDER=ollama.
# Ollama model names can be changed if different models are installed.
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
